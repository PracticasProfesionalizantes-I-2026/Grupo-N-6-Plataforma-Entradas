{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=entradapp.db"
  },
  "Jwt": {
    "Issuer": "EntradApp",
    "Audience": "EntradAppUsers"
  },
  "PrecioDinamico": {
    "UmbralOcupacion": 80,
    "PorcentajeIncremento": 20,
    "IntervaloMinutos": 5
  },
  "ReservaTemporal": {
    "DuracionMinutos": 10,
    "LimpiezaIntervaloMinutos": 1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
