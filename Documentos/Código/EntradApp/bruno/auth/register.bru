{
  "name": "Registrar Usuario",
  "type": "http-request",
  "method": "POST",
  "url": "http://localhost:5000/api/v1/auth/register",
  "headers": [
    { "name": "Content-Type", "value": "application/json" }
  ],
  "body": {
    "type": "json",
    "content": "{\n  \"email\": \"nuevo@test.com\",\n  \"password\": \"Usuario123!\",\n  \"nombre\": \"Nuevo\",\n  \"apellido\": \"Usuario\",\n  \"dni\": \"12345678\",\n  \"fechaNacimiento\": \"1995-05-15T00:00:00\"\n}"
  }
}