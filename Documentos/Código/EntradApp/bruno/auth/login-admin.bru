{
  "name": "Login SuperAdmin",
  "type": "http-request",
  "method": "POST",
  "url": "http://localhost:5000/api/v1/auth/login",
  "headers": [
    { "name": "Content-Type", "value": "application/json" }
  ],
  "body": {
    "type": "json",
    "content": "{\n  \"email\": \"admin@entradapp.com\",\n  \"password\": \"Admin123!\"\n}"
  },
  "scripts": {
    "post-response": "if (res.status === 200) { bruno.setVar('adminToken', res.body.token); }"
  }
}