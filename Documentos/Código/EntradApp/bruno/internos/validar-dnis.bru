{
  "name": "Validar DNI Duplicados",
  "type": "http-request",
  "method": "POST",
  "url": "http://localhost:5000/api/v1/interno/validar/dnis",
  "headers": [
    { "name": "Content-Type", "value": "application/json" },
    { "name": "Authorization", "value": "Bearer {{token}}" }
  ],
  "body": {
    "type": "json",
    "content": "{\n  \"eventoId\": \"{{eventoId}}\",\n  \"dnis\": [\"12345678\", \"87654321\"]\n}"
  }
}