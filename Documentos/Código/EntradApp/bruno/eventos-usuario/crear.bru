{
  "name": "Crear Evento",
  "type": "http-request",
  "method": "POST",
  "url": "http://localhost:5000/api/v1/eventos",
  "headers": [
    { "name": "Content-Type", "value": "application/json" },
    { "name": "Authorization", "value": "Bearer {{token}}" }
  ],
  "body": {
    "type": "json",
    "content": "{\n  \"nombre\": \"Concierto Rock 2026\",\n  \"descripcion\": \"Gran concierto de rock\",\n  \"fechaInicio\": \"2026-12-15T20:00:00\",\n  \"fechaFin\": \"2026-12-15T23:00:00\",\n  \"lugar\": \"Estadio Central\",\n  \"direccion\": \"Av. Principal 123\",\n  \"sectores\": [\n    { \"nombre\": \"Platea\", \"capacidad\": 100, \"precioBase\": 15000 },\n    { \"nombre\": \"Popular\", \"capacidad\": 200, \"precioBase\": 8000 }\n  ]\n}"
  },
  "scripts": {
    "post-response": "if (res.status === 201) { bruno.setVar('eventoId', res.body.id); }"
  }
}