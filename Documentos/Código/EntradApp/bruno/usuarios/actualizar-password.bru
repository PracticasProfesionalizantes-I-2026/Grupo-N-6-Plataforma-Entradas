{
  "name": "Cambiar Contraseña",
  "type": "http-request",
  "method": "PUT",
  "url": "http://localhost:5000/api/v1/usuarios/password",
  "headers": [
    { "name": "Content-Type", "value": "application/json" },
    { "name": "Authorization", "value": "Bearer {{token}}" }
  ],
  "body": {
    "type": "json",
    "content": "{\n  \"passwordActual\": \"Usuario123!\",\n  \"passwordNueva\": \"NuevaPass123!\"\n}"
  }
}